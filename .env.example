# LLM: claude_cli (default; uses your logged-in Claude subscription via the `claude` CLI,
# no API key needed) | openrouter | anthropic | openai
LLM_PROVIDER=claude_cli
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=haiku
JUDGE_MODEL=haiku
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Embeddings (local, multilingual)
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Retrieval / graph
TOP_K=6
USE_MMR=false
MIN_RELEVANT_DOCS=1
MAX_REWRITES=2
MAX_REGENERATIONS=1
CHUNK_SIZE=800
CHUNK_OVERLAP=120
CHROMA_DIR=./data/chroma

# Optional tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Public demo (all off by default)
# DEMO_MODE=true makes the app read-only: uploads and deletes are refused.
DEMO_MODE=false
# Questions per minute per client IP, and per day across all clients (spend cap). 0 = unlimited.
ASK_RATE_PER_MINUTE=0
ASK_DAILY_LIMIT=0
# PRELOAD=true loads the models and indexes data/samples at startup when the index is empty.
PRELOAD=false
# DEMO_REPLAY=true answers only from recorded answers (no model calls, no key needed).
# Record them with: PYTHONPATH=src python scripts/record_demo.py
DEMO_REPLAY=false
DEMO_ANSWERS_FILE=./data/demo_answers.json
