# LLM: claude_cli (default; uses your logged-in Claude subscription via the `claude` CLI,
# no API key needed) | openrouter | anthropic | openai
LLM_PROVIDER=claude_cli
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=haiku
JUDGE_MODEL=haiku
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Embeddings (local, multilingual)
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Retrieval / graph
TOP_K=6
USE_MMR=false
MIN_RELEVANT_DOCS=1
MAX_REWRITES=2
MAX_REGENERATIONS=1
CHUNK_SIZE=800
CHUNK_OVERLAP=120
CHROMA_DIR=./data/chroma

# Optional tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
